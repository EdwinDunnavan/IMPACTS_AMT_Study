\@writefile{lof}{\contentsline {figure}{\numberline {B1}{\ignorespaces P-3 aircraft coordinates in the X-Z (a) and X-Y (b) planes (note that this is a different basis than what is shown in Fig.~\ref {fig:P3}). Panels c and d show pictures of the P-3 station 18 pylons and probes for the IMPACTS 2020 (c) and IMPACTS 2022 (d) campaigns. The dotted red ellipse shows the additional fairing added in 2021 to the extended pylon. Panels e and f show the differences in 2D-S probe location between the 2020 campaign (blue) and the 2022-2023 campaigns (green) in the Y-Z (e) and X-Z (f) planes. The purple canister, probes and pylon shown in panel e represent the configuration of the original pylon before the IMPACTS 2020 campaign whereas the blue and green configurations represent the extended pylons used during the IMPACTS campaign for 2020 and 2022-2023 campaigns. Purple circles in panels a and b indicate the origin of the aircraft used in Fig.~\ref {fig:CFD_tests}. More information regarding the P-3 CAD measurements can be found in \citet  {Hunter2025}.}}{51}{figure.caption.25}\protected@file@percent }
\newlabel{fig:pylon_comp}{{B1}{51}{P-3 aircraft coordinates in the X-Z (a) and X-Y (b) planes (note that this is a different basis than what is shown in Fig.~\ref {fig:P3}). Panels c and d show pictures of the P-3 station 18 pylons and probes for the IMPACTS 2020 (c) and IMPACTS 2022 (d) campaigns. The dotted red ellipse shows the additional fairing added in 2021 to the extended pylon. Panels e and f show the differences in 2D-S probe location between the 2020 campaign (blue) and the 2022-2023 campaigns (green) in the Y-Z (e) and X-Z (f) planes. The purple canister, probes and pylon shown in panel e represent the configuration of the original pylon before the IMPACTS 2020 campaign whereas the blue and green configurations represent the extended pylons used during the IMPACTS campaign for 2020 and 2022-2023 campaigns. Purple circles in panels a and b indicate the origin of the aircraft used in Fig.~\ref {fig:CFD_tests}. More information regarding the P-3 CAD measurements can be found in \citet {Hunter2025}}{figure.caption.25}{}}
